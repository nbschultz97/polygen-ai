    {
      "@type": "FAQPage",
      "@id": "https://polygen.ai/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is PolyGen AI?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "PolyGen AI is an AI-powered platform that converts text descriptions and images into 3D-printable models. Using advanced multi-agent AI technology with Gemini and Claude, it generates parametric OpenSCAD code that you can customize and export as STL files for 3D printing."
          }
        },
        {
          "@type": "Question",
          "name": "How does text-to-3D work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Simply describe what you want to create in plain English, like 'a coffee cup holder with space for a phone'. Our AI agents analyze your description, generate optimized OpenSCAD code, and provide a real-time 3D preview. You can then iterate on the design or export directly to STL."
          }
        },
        {
          "@type": "Question",
          "name": "What file formats does PolyGen AI support?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "PolyGen AI exports to OpenSCAD code format (.scad) which can be edited in any text editor, and STL format (.stl) which is compatible with all 3D printers and slicers like Cura, PrusaSlicer, and Simplify3D."
          }
        },
        {
          "@type": "Question",
          "name": "Is there a free plan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! PolyGen AI offers a free plan with 5 generations per month, access to basic design templates, and OpenSCAD code export. No credit card required to get started."
          }
        }
      ]
    },
