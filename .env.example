# ============================================
# PolyGen AI - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values

# ============================================
# AI API Keys
# ============================================

# Google Gemini API Key (for Planner agent)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-pro-preview
THINKING_LEVEL=high

# Anthropic Claude API Key (for Coder agent)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Enable multi-agent pipeline (Planner -> Coder -> Validator)
USE_MULTI_AGENT=true

# ============================================
# Supabase (Authentication & Database)
# ============================================

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (safe for client-side)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Service Role Key (server-side only, never expose)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# Stripe (Payments)
# ============================================

# Stripe Secret Key (server-side only)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key

# Stripe Webhook Secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (from your Stripe Dashboard)
VITE_STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly_id
VITE_STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly_id
VITE_STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_enterprise_monthly_id
VITE_STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_enterprise_yearly_id

# Also set these for the webhook handler
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly_id
STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly_id
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_enterprise_monthly_id
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_enterprise_yearly_id

# ============================================
# App Configuration
# ============================================

# Public app URL (for redirects)
NEXT_PUBLIC_APP_URL=https://polygen.ai

# ============================================
# Analytics
# ============================================

# Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
