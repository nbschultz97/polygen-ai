# ============================================
# PolyGen AI - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
#
# QUICK START (demo mode - no accounts needed):
#   1. Set GEMINI_API_KEY and ANTHROPIC_API_KEY
#   2. Run `pnpm dev`
#   3. The app works without Supabase/Stripe (auth features disabled)
#
# FULL SETUP (auth + payments):
#   Also configure Supabase and Stripe sections below.

# ============================================
# AI API Keys (REQUIRED for generation)
# ============================================

# Google Gemini API Key (for Planner agent)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (default: gemini-2.5-flash-preview)
GEMINI_MODEL=gemini-2.5-flash-preview
THINKING_LEVEL=high

# Anthropic Claude API Key (for Coder agent)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude model for code generation (default: claude-sonnet-4-20250514)
# CODER_MODEL=claude-sonnet-4-20250514

# Enable multi-agent pipeline (Planner → Coder → Validator)
# Set to "true" for higher quality (75% success rate vs 44% unified)
USE_MULTI_AGENT=true

# ============================================
# Supabase (Authentication & Database)
# OPTIONAL - app works without these (demo mode)
# ============================================

# Supabase Project URL (from Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (safe for client-side)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Service Role Key (server-side only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# Stripe (Payments)
# OPTIONAL - only needed for paid subscriptions
# ============================================

# Stripe Secret Key (server-side only)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe Webhook Secret (from Stripe Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (from Stripe Dashboard → Products)
VITE_STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly_id
VITE_STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly_id
VITE_STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_enterprise_monthly_id
VITE_STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_enterprise_yearly_id

# Server-side duplicates for webhook handler
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly_id
STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly_id
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_enterprise_monthly_id
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_enterprise_yearly_id

# ============================================
# App Configuration
# ============================================

# Public app URL (for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:5173

# ============================================
# Analytics (OPTIONAL)
# ============================================

# Google Analytics 4 Measurement ID
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
